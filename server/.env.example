# Copy to .env and fill in. Values already set in the environment win over this file.

# Postgres connection string
DATABASE_URL=postgresql://projectpro:projectpro@localhost:5432/projectpro

# At least 32 characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Base URL the server is reached on
BETTER_AUTH_URL=http://localhost:3000

# Port the server listens on (default 3000)
PORT=3000
